{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "New Empires UI Design Tokens - Medieval Kingdom Aesthetic",
  "version": "2.0.0",
  "color": {
    "brand": {
      "gold": { "value": "#d4af37", "description": "Dorado rey medieval para acentos, títulos y filigranas" },
      "goldLight": { "value": "#f3e5ab", "description": "Dorado brillante para hovers y bordes resplandecientes" },
      "bronze": { "value": "#8c6239", "description": "Bronce forjado para marcos secundarios" },
      "iron": { "value": "#2b2b36", "description": "Hierro oscuro tallado para estructura de contenedores" },
      "crimson": { "value": "#8b0000", "description": "Rojo carmesí señorial para alertas y estado enemigo" },
      "emerald": { "value": "#2e7d32", "description": "Verde esmeralda para estado aliado y confirmaciones" }
    },
    "medievalKingdom": {
      "bgPrimary": { "value": "#16131c", "description": "Fondo de piedra oscura pulida sólida" },
      "bgSecondary": { "value": "#221c2c", "description": "Fondo de piedra tallada para paneles internos" },
      "bgParchment": { "value": "#2d241e", "description": "Tono pergamino/cuero oscuro envejecido para cajas de contenido" },
      "borderGold": { "value": "#b89635", "description": "Borde de hierro forjado con remates dorados" },
      "borderHover": { "value": "#ffd700", "description": "Resplandor de oro brillante en estado hover" },
      "borderWood": { "value": "#5c3a21", "description": "Borde de madera de roble esculpida" }
    },
    "text": {
      "primary": { "value": "#f5e6c8", "description": "Texto marfil envejecido de alta legibilidad" },
      "secondary": { "value": "#d0c0a0", "description": "Texto pergamino para descripciones y tooltips" },
      "accent": { "value": "#ffd700", "description": "Texto dorado resplandeciente para valores numéricos" },
      "muted": { "value": "#8c8070", "description": "Texto tallado desactivado o atenuado" }
    },
    "resources": {
      "wood": { "value": "#b8860b", "description": "Color temático madera de roble" },
      "food": { "value": "#81c784", "description": "Color temático cosecha de grano" },
      "gold": { "value": "#ffd700", "description": "Color temático lingote de oro" },
      "stone": { "value": "#a0b0b8", "description": "Color temático cantera de piedra" }
    }
  },
  "typography": {
    "fontFamily": {
      "header": { "value": "'Cinzel', 'Georgia', serif" },
      "body": { "value": "'Inter', '-apple-system', 'Segoe UI', sans-serif" }
    },
    "fontSize": {
      "xs": { "value": "12px" },
      "sm": { "value": "14px" },
      "base": { "value": "16px" },
      "lg": { "value": "18px" },
      "xl": { "value": "24px" },
      "title": { "value": "32px" }
    },
    "fontWeight": {
      "regular": { "value": 400 },
      "medium": { "value": 500 },
      "semiBold": { "value": 600 },
      "bold": { "value": 700 }
    }
  },
  "elevation": {
    "boxShadow": {
      "panel": { "value": "0 10px 30px rgba(0, 0, 0, 0.95), inset 0 1px 2px rgba(255, 215, 0, 0.25)" },
      "button": { "value": "0 4px 8px rgba(0, 0, 0, 0.70), inset 0 1px 0 rgba(255, 255, 255, 0.15)" },
      "carvedInset": { "value": "inset 0 2px 6px rgba(0, 0, 0, 0.90)" },
      "glowGold": { "value": "0 0 18px 3px rgba(255, 215, 0, 0.60)" }
    }
  },
  "animation": {
    "fast": { "value": "0.15s ease-out" },
    "normal": { "value": "0.25s ease-in-out" },
    "pulse": { "value": "1.5s infinite alternate" }
  },
  "spacing": {
    "xs": { "value": "4px" },
    "sm": { "value": "8px" },
    "md": { "value": "16px" },
    "lg": { "value": "24px" },
    "xl": { "value": "32px" }
  },
  "borderRadius": {
    "sm": { "value": "4px" },
    "md": { "value": "8px" },
    "lg": { "value": "12px" },
    "full": { "value": "9999px" }
  }
}
